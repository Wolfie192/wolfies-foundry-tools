<div style="padding: 10px; user-select: text;">
    <h3 style="margin-top: 5px; border-bottom: 1px solid #777;">1. Simple DC Tag (With Skill)</h3>
    <div style="background: rgba(0,0,0,0.1); padding: 8px; border: 1px solid #444; font-family: monospace;">
        @PFS[type:dc|skill:Stealth|low:15|high:18]
    </div>

    <h3 style="margin-top: 15px; border-bottom: 1px solid #777;">2. Granular DC Tag (With Skill)</h3>
    <div style="background: rgba(0,0,0,0.1); padding: 8px; border: 1px solid #444; font-family: monospace;">
        @PFS[type:dc|skill:Diplomacy|low:15|low_14_15:16|high:18|high_23_27:20]
    </div>

    <h3 style="margin-top: 15px; border-bottom: 1px solid #777;">3. Macro Tag</h3>
    <div style="background: rgba(0,0,0,0.1); padding: 8px; border: 1px solid #444; font-family: monospace;">
        @PFS[type:macro|low:MyLowMacro|high:MyHighMacro]
    </div>
</div>