<form>
    <!-- NEW: Info Block -->
    <div style="margin-bottom: 15px; padding: 10px; background: rgba(0,0,0,0.05); border: 1px solid #777; border-radius: 5px;">
        <strong style="font-size: 14px; display: block; margin-bottom: 6px; border-bottom: 1px solid #ccc; padding-bottom: 4px;">
            <i class="fas fa-info-circle"></i> Available Checks
        </strong>
        <ul style="margin: 0; padding-left: 24px; font-size: 13px;">
            {{#each config.skills}}
                <li style="margin-bottom: 3px;">
                    {{#if this.act}}<strong>{{this.act}}</strong> ({{this.name}}){{else}}<strong>{{this.name}}</strong>{{/if}}
                    {{#if this.profName}} <span style="font-style: italic; color: #555;">[{{this.profName}}]</span>{{/if}}
                    <span style="font-weight: bold; color: #8a1a1b;">- DC {{this.dc}}</span>
                </li>
            {{/each}}
        </ul>
    </div>

    <!-- Main Table -->
    <table style="width: 100%; margin-bottom: 10px; text-align: left; border-collapse: collapse;">
        <thead>
        <tr style="border-bottom: 1px solid #777;">
            <th style="padding-bottom: 5px;">Character</th>
            <th style="padding-bottom: 5px;">Skill</th>
            {{#if config.secret}}
                <th style="padding-bottom: 5px; text-align: center;">Mod</th>
                <th style="padding-bottom: 5px; text-align: center;">D20</th>
            {{else}}
                <th style="padding-bottom: 5px; text-align: center;">Total</th>
            {{/if}}
            <th style="padding-bottom: 5px;">Result</th>
        </tr>
        </thead>
        <tbody>
        {{#each members}}
            <tr>
                <td style="padding: 5px 0;"><strong>{{this.name}}</strong></td>
                <td style="padding: 5px 5px 5px 0;">
                    <select class="skill-select" style="width: 100%; text-overflow: ellipsis;">
                        {{#each this.validOptions}}
                            <option value="{{this.slug}}" data-dc="{{this.dc}}" data-mod="{{this.mod}}">{{this.name}}</option>
                        {{/each}}
                    </select>
                </td>
                {{#if ../config.secret}}
                    <td style="padding: 5px 5px 5px 0; text-align: center;">
                        <input type="number" class="mod-input" style="width: 50px; text-align: center;" placeholder="Mod" value="{{this.validOptions.[0].mod}}">
                    </td>
                    <td style="padding: 5px 5px 5px 0; text-align: center;">
                        <input type="number" class="roll-input d20-input" style="width: 50px; text-align: center;" placeholder="d20" value="{{this.autoRoll}}">
                    </td>
                {{else}}
                    <td style="padding: 5px 5px 5px 0; text-align: center;">
                        <input type="number" class="roll-input total-input" style="width: 50px; text-align: center;" placeholder="Total">
                    </td>
                {{/if}}
                <td style="padding: 5px 0;">
                    <select name="{{this.id}}" class="override-select" style="width: 100%;">
                        <option value="None" selected>None</option>
                        <option value="Crit Success">Crit Success</option>
                        <option value="Success">Success</option>
                        <option value="Failure">Failure</option>
                        <option value="Crit Failure">Crit Failure</option>
                    </select>
                </td>
            </tr>
        {{/each}}
        </tbody>
    </table>
</form>